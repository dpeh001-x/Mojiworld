.DS_Store
Thumbs.db
*.log
.vscode/
.idea/
node_modules/
dist/
build/
# ...but the electron-builder icon resources ARE tracked
!steam/build/

# Local temp files
*.tmp
*.swp
*~

# MCP server config — contains API keys, never commit
.mcp.json

# Claude Code session files (transcripts, caches)
.claude/
# ...but track the versioned hook + settings used by the team
!.claude/
!.claude/hooks/
!.claude/hooks/session-start.sh
!.claude/settings.json
# Developer-specific local Claude config — never commit
.claude/settings.local.json
.claude/launch.json
game_script.js

# Recovery / atomic-write artifacts (truncation incident, 2026-06-10)
*.bak
_c.js
.__recovered*
.__recv*

# One-off probe/patch scratch scripts. Sessions drop these next to the real
# tooling; the _tmp_ prefix keeps them out of git status so genuine changes stay
# visible. Anything worth keeping gets a real name.
scripts/_tmp_*
tools/_tmp_*

# scratch recordings / teaser material — never ship (176MB mp4 blocked GitHub push once)
tools/Teaser2/
tools/teaser 3/
tools/teaser/
steam/release/
steam/steam_build_output/

# SteamCMD, when it is unpacked into the repo root (it self-updates in place and
# scatters these next to it). steamcmd.exe alone is 5.2MB and the package/ tree
# grows with every run, so without this a routine `git add -A` sweeps the whole
# SteamPipe client into the repo. config/ additionally holds the login token for
# the builder account — it must never be committed.
/steamcmd.exe
/steamcmd.exe.old
/steamcmd.exe.*.delete
/config/
/logs/
/package/
# The first real +login unpacks the full Steam client runtime next to the exe —
# ~20 more root-level entries the earlier rule (written before any login had
# run) did not anticipate. userdata/ and config/ hold account state and the
# builder login token, so these are a credential leak away from one `git add -A`.
/appcache/
/bin/
/public/
/siteserverui/
/steamapps/
/userdata/
/update_hosts_cached.vdf
/steamerrorreporter.exe
/crashhandler*.dll
/crashhandler*.dll.old
/steam.dll
/steamclient*.dll
/steamconsole*.dll
/tier0_s*.dll
/vstdlib_s*.dll

# v0.29.421 — art-review scratch: generated candidates, contact sheets and
# pre-install backups. The chosen art is committed under Sprites/; these are
# the working set behind it and would add ~20MB of rejected PNGs.
scripts/_mage_orb_review/

# v0.29.452 — mojimon celebration art review scratch (candidates + backups)
scripts/_mojimon_celebration/

# v0.29.468 — background art arrives as 3-6 MB PNG; the game only ever loads
# the webp beside it (0.2-0.7 MB), and the Pages build streams these from
# jsDelivr. Keep the delivered originals on disk, out of the repo.
backgrounds/*.png
