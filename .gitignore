.DS_Store
Thumbs.db
*.log
.vscode/
.idea/
node_modules/
dist/
build/
# ...but the electron-builder icon resources ARE tracked
!steam/build/

# Local temp files
*.tmp
*.swp
*~

# MCP server config — contains API keys, never commit
.mcp.json

# Claude Code session files (transcripts, caches)
.claude/
# ...but track the versioned hook + settings used by the team
!.claude/
!.claude/hooks/
!.claude/hooks/session-start.sh
!.claude/settings.json
# Developer-specific local Claude config — never commit
.claude/settings.local.json
.claude/launch.json
game_script.js

# Recovery / atomic-write artifacts (truncation incident, 2026-06-10)
*.bak
_c.js
.__recovered*
.__recv*

# One-off probe/patch scratch scripts. Sessions drop these next to the real
# tooling; the _tmp_ prefix keeps them out of git status so genuine changes stay
# visible. Anything worth keeping gets a real name.
scripts/_tmp_*
tools/_tmp_*

# scratch recordings / teaser material — never ship (176MB mp4 blocked GitHub push once)
tools/Teaser2/
tools/teaser 3/
tools/teaser/
steam/release/
steam/steam_build_output/

# SteamCMD, when it is unpacked into the repo root (it self-updates in place and
# scatters these next to it). steamcmd.exe alone is 5.2MB and the package/ tree
# grows with every run, so without this a routine `git add -A` sweeps the whole
# SteamPipe client into the repo. config/ additionally holds the login token for
# the builder account — it must never be committed.
/steamcmd.exe
/steamcmd.exe.old
/steamcmd.exe.*.delete
/config/
/logs/
/package/
