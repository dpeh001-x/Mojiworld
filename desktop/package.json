{
  "name": "mojiworld-desktop",
  "productName": "Mojiworld",
  "version": "0.29.97",
  "description": "Mojiworld — desktop edition",
  "main": "main.js",
  "author": "Moji Studios",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.mojistudios.mojiworld",
    "productName": "Mojiworld",
    "compression": "store",
    "directories": { "output": "dist" },
    "files": ["main.js", "package.json"],
    "extraResources": [
      { "from": "../mojiworld_game.html", "to": "game/mojiworld_game.html" },
      { "from": "../assets_manifest.json", "to": "game/assets_manifest.json" },
      {
        "from": "../Sprites",
        "to": "game/Sprites",
        "filter": ["**/*", "!**/_backup*/**", "!**/*.tmp"]
      },
      {
        "from": "../audio",
        "to": "game/audio",
        "filter": ["**/*", "!**/_backup*/**"]
      },
      {
        "from": "../steam/higgsfield/cinematics",
        "to": "game/steam/higgsfield/cinematics",
        "filter": ["**/*.mp4", "!**/_backup*/**"]
      }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Mojiworld"
    }
  }
}
