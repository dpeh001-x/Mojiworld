// Windows depot — ships the UNPACKED electron-builder output. Steam itself is
// the installer; players get the folder verbatim and the launch option runs
// Mojiworld.exe from the depot root.
"DepotBuild"
{
	"DepotID" "1000001"
	"FileMapping"
	{
		"LocalPath" "win-unpacked\*"
		"DepotPath" "."
		"recursive" "1"
	}
	"FileExclusion" "*.pdb"
}
