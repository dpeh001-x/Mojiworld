// Mojiworld — SteamPipe app build script.
// Usage (from the Steamworks SDK's tools/ContentBuilder/builder dir, or any steamcmd):
//   steamcmd +login <builder_account> +run_app_build <absolute path>\app_build.vdf +quit
// Replace every 1000000 with your real App ID (depots are AppID+1 / AppID+2 by
// Steamworks convention — use the depot IDs shown on your App Admin > Depots page).
// ContentRoot points at steam/release/ (what `npm run dist:steamwin` /
// `npm run dist:steamdeck` emit); BuildOutput holds SteamPipe logs + cache.
"AppBuild"
{
	"AppID" "1000000"
	"Desc" "Mojiworld — automated build"
	"ContentRoot" "..\release\"
	"BuildOutput" "..\steam_build_output\"
	"SetLive" ""	// set to "beta" (or another branch name) to auto-publish to that branch
	"Depots"
	{
		"1000001" "depot_windows.vdf"
		"1000002" "depot_linux.vdf"
	}
}
