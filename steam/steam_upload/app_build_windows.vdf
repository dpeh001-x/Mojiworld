// Mojiworld — SteamPipe app build script, WINDOWS ONLY.
//
//   steamcmd +login <builder_account> +run_app_build <abs path>\app_build_windows.vdf +quit
//
// Use this for a Windows-only upload. The full app_build.vdf references BOTH
// depots, and SteamPipe fails the whole build if a depot's ContentRoot is
// missing — so it cannot be used until `npm run dist:steamdeck` has produced
// steam/release/linux-unpacked/. Depot 4842652 exists in Steamworks and is
// scoped to Linux + SteamOS; it simply has no content yet, which is fine —
// an unbuilt depot is not offered to players.
//
// Switch back to app_build.vdf once a Linux payload exists, and remember to
// widen the app's `oslist` (App Admin > common) from "windows" to
// "windows,linux" or Steam Deck users will not see the game at all.
//
// ContentRoot points at steam/release/ (what `npm run dist:steamwin` emits);
// BuildOutput holds SteamPipe logs + cache.
"AppBuild"
{
	"AppID" "4842650"
	"Desc" "Mojiworld — Windows depot"
	"ContentRoot" "..\release\"
	"BuildOutput" "..\steam_build_output\"
	"SetLive" ""	// leave empty: upload without publishing to a branch, then set live from SteamPipe > Builds
	"Depots"
	{
		"4842651" "depot_windows.vdf"
	}
}
