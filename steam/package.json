{
  "name": "mojiworld-desktop",
  "productName": "Mojiworld",
  "version": "0.29.0",
  "description": "Mojiworld — casual co-op action-RPG (Steam desktop build)",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test_static_server.mjs",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:steamwin": "electron-builder --win dir",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "dist:steamdeck": "electron-builder --linux dir"
  },
  "dependencies": {
    "steamworks.js": "^0.4.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.mojiworld.game",
    "productName": "Mojiworld",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["main.js", "preload.js", "steam_integration.js", "static_server.js", "relay.config.json", "steam_appid.txt", "node_modules/steamworks.js/**"],
    "asarUnpack": ["node_modules/steamworks.js/**"],
    "extraResources": [
      {
        "from": "..",
        "to": "app",
        "filter": [
          "mojiworld_game.html",
          "sw.js",
          "gear_calibration.js",
          "gear_erase.js",
          "mob_offsets.js",
          "npc_offsets.js",
          "anim_calib.js",
          "Sprites/**",
          "audio/**",
          "backgrounds/**",
          "steam/higgsfield/cinematics/clip_093232.mp4",
          "steam/higgsfield/cinematics/clip_094612.mp4",
          "steam/higgsfield/cinematics/clip_095142.mp4",
          "steam/higgsfield/cinematics/clip_100640.mp4",
          "steam/higgsfield/cinematics/clip_100914.mp4",
          "steam/higgsfield/cinematics/clip_101446.mp4",
          "steam/higgsfield/cinematics/clip_101725.mp4",
          "steam/higgsfield/cinematics/clip_amnesiac_s1.mp4",
          "steam/higgsfield/cinematics/clip_forge_s1.mp4",
          "steam/higgsfield/cinematics/clip_gravitos_defeat_dragonknight.mp4",
          "steam/higgsfield/cinematics/clip_gravitos_entry.mp4",
          "steam/higgsfield/cinematics/clip_gravitos_s1.mp4",
          "steam/higgsfield/cinematics/clip_prologue_pov.mp4",
          "steam/higgsfield/cinematics/clip_prologue_punch.mp4",
          "steam/higgsfield/cinematics/prologue_void_transcend.mp4"
        ]
      },
      { "from": "controller_config", "to": "controller_config" }
    ],
    "win": { "target": ["dir", "nsis"], "icon": "build/icon.ico" },
    "nsis": { "artifactName": "Mojiworld-Setup-${version}.${ext}", "shortcutName": "Mojiworld" },
    "mac": { "target": ["dmg"], "category": "public.app-category.games", "icon": "build/icon.png" },
    "linux": { "target": ["AppImage", "dir"], "category": "Game", "executableName": "mojiworld", "icon": "build/icon.png" }
  }
}
