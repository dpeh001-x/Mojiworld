// Mojiworld — Steam Input Game Actions File.
//
// Defines the in-game action set + digital/analog actions that Steam Input binds
// a controller to. Uploaded to Steamworks (Edit Steam Input Configuration) so a
// player's Steam controller config drives these actions; steam_integration.js
// resolves each digital action by name (getDigitalActionHandle) and reports its
// pressed state to the game, which maps it to the same input as the keyboard.
//
// The filename MUST be game_actions_<APP_ID>.vdf — Steam Input looks it up by
// App ID, so a stale name means the config is silently never found. Renamed from
// game_actions_480.vdf (Spacewar placeholder) to 4842650 when the real App ID
// landed; tools/set_steam_appid.mjs now renames it automatically.
// Keep the Button names in sync with INPUT_ACTIONS in steam_integration.js —
// getDigitalActionHandle() resolves by name, so a typo means that control
// silently never fires on a controller.
"In Game Actions"
{
	"actions"
	{
		"InGameControls"
		{
			"title"		"#Set_InGame"
			"StickPadGyro"
			{
				"Move"
				{
					"title"			"#Action_Move"
					"input_mode"	"joystick_move"
				}
			}
			"AnalogTrigger"
			{
			}
			"Button"
			{
				"jump"			"#Action_Jump"
				"dodge"			"#Action_Dodge"
				"z"				"#Action_Attack"
				"talkNpc"		"#Action_Interact"
				"x"				"#Action_Skill1"
				"s"				"#Action_Skill2"
				"c"				"#Action_Skill3"
				"d"				"#Action_Skill4"
				"f"				"#Action_Skill5"
				"v"				"#Action_Skill6"
				"attributesU"	"#Action_CharacterPanel"
				"escape"		"#Action_Pause"
				"moveUp"		"#Action_Up"
				"moveDown"		"#Action_Down"
				"moveLeft"		"#Action_Left"
				"moveRight"		"#Action_Right"
			}
		}
	}
	"localization"
	{
		"english"
		{
			"Set_InGame"				"In-Game"
			"Action_Move"				"Move"
			"Action_Jump"				"Jump"
			"Action_Dodge"				"Dodge / Roll"
			"Action_Attack"				"Attack"
			"Action_Interact"			"Interact / Talk"
			"Action_Skill1"				"Skill 1"
			"Action_Skill2"				"Skill 2"
			"Action_Skill3"				"Skill 3"
			"Action_Skill4"				"Skill 4"
			"Action_Skill5"				"Skill 5"
			"Action_Skill6"				"Skill 6"
			"Action_CharacterPanel"		"Character Panel"
			"Action_Pause"				"Pause / Close"
			"Action_Up"					"Up / Climb"
			"Action_Down"				"Down / Drop"
			"Action_Left"				"Left"
			"Action_Right"				"Right"
		}
	}
}
